# ── NextAuth & Google Authentication ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here_or_generate_with_openssl_rand_base64_32
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── Database Path (Optional: defaults to ./data/pharma.db) ──
DATABASE_PATH=./data/pharma.db

# ── Gemini API Keys (Fallback hierarchy across DDI analysis, Aastha chat, and Prescription OCR) ──

# Key 1 — Primary for DDI analysis, reports, Aastha AI
GEMINI_API_KEY=your-gemini-api-key-here

# Key 2 — Fallback for DDI/reports/chat when Key 1 is rate-limited
GEMINI_API_KEY_SECONDARY=your-secondary-gemini-api-key-here

# Key 3 — Prescription OCR primary (also used as chat/DDI fallback)
PRESCRIPTION_GEMINI_API_KEY_3=your-third-gemini-api-key-here

# Key 4 — Prescription OCR fallback (also used as chat/DDI fallback)
PRESCRIPTION_GEMINI_API_KEY_4=your-fourth-gemini-api-key-here

# Key 5 — Extra backup key (fallback for all tasks)
GEMINI_API_KEY_5=your-fifth-gemini-api-key-here

# Key 6 — Extra backup key 2 (fallback for all tasks)
GEMINI_API_KEY_6=your-sixth-gemini-api-key-here

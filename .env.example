# Groq API Key (required for Llama 3.1 8B Instant)
GROQ_API_KEY=gsk_your_api_key_here

# Optional model override (default: llama-3.1-8b-instant)
# AI_MODEL=llama-3.1-8b-instant

# Legacy Keys (optional)
OPENAI_API_KEY=sk-your-api-key-here

# ── Gemini API Keys ──────────────────────────────
# API 1 — Primary key for DDI analysis, reports, Aastha AI
GEMINI_API_KEY=your-gemini-api-key-here

# API 2 — Fallback for DDI/reports when API 1 is rate-limited
GEMINI_API_KEY_SECONDARY=your-secondary-gemini-api-key-here

# API 3 — Dedicated Prescription OCR (primary, never used for DDI/reports)
PRESCRIPTION_GEMINI_API_KEY_3=your-third-gemini-api-key-here

# API 4 — Fallback Prescription OCR (used if API 3 is rate-limited or missing)
PRESCRIPTION_GEMINI_API_KEY_4=your-fourth-gemini-api-key-here

# Database path (SQLite)
DATABASE_PATH=./data/farma.db

# Analysis cache TTL in hours (default: 24)
CACHE_TTL_HOURS=24

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
